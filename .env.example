# Public address of the app, exactly as people open it (no trailing slash).
# In local development this is the Vite dev server.
PUBLIC_URL=http://localhost:5173

# PostgreSQL connection string. For local development without Docker you can use
# DATABASE_URL=pglite  (in-memory) or  DATABASE_URL=pglite:./.pgdata  (kept on disk).
DATABASE_URL=postgres://mdb:mdb@localhost:5432/mdb

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=3000
LOG_LEVEL=info
